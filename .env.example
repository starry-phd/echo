# 原生 App 的正式 API 原點為 https://echo.starry.phd；Web 同源時可留空。\n# Native EAS 正式打包請設定 EXPO_PUBLIC_ECHO_API_BASE_URL=https://echo.starry.phd（不可放金鑰）。
# 不要把金鑰寫進 EXPO_PUBLIC 變數。
EXPO_PUBLIC_ECHO_API_BASE_URL=
# 審閱並實作中央會員契約後才設定。預定中央 D1 名稱 id-starry 不是 API 網址。
EXPO_PUBLIC_STARRY_ID_API_BASE_URL=

# dev | preview | production，未填時僅保留 app.json 固定 brand/app 身分。
EXPO_PUBLIC_APP_ENV=
