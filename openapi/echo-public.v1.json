{
  "openapi": "3.1.0",
  "info": {
    "title": "Starry Echo Public API",
    "version": "1.0.0",
    "description": "Public read-only audio API for Echo. Starry central member API (planned D1 id-starry) is independent and NOT described as implemented."
  },
  "servers": [
    {
      "url": "/",
      "description": "Relative Worker origin; real deployment/availability must be verified separately."
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getEchoHealth",
        "summary": "Read-only health status",
        "security": [],
        "responses": {
          "200": {
            "description": "Worker bootstrap status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "operationId": "listEchoCategories",
        "summary": "Public category labels",
        "security": [],
        "responses": {
          "200": {
            "description": "Category labels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "categories"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "operationId": "listEchoTracks",
        "summary": "Only verified public audio",
        "security": [],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 80
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Verified public catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "tracks"
                  ],
                  "properties": {
                    "tracks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Track"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracks/{id}/stream": {
      "get": {
        "operationId": "streamEchoTrack",
        "summary": "Seekable public verified audio",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audio stream",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "Partial audio",
            "content": {
              "audio/mpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid track ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unverified or missing audio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "416": {
            "description": "Invalid byte range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tracks/{id}": {
      "get": {
        "operationId": "getEchoTrack",
        "summary": "One verified public track; deep links do not depend on catalog pagination",
        "security": [],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public verified track metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "track"
                  ],
                  "properties": {
                    "track": {
                      "$ref": "#/components/schemas/Track"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid track id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found, private or not verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "service",
          "stage",
          "apiVersion",
          "database",
          "storage",
          "centralMemberApi",
          "legacyMediaMigration"
        ],
        "properties": {
          "service": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "apiVersion": {
            "type": "string"
          },
          "centralMemberApi": {
            "type": "string"
          },
          "legacyMediaMigration": {
            "type": "string"
          },
          "database": {
            "type": "boolean"
          },
          "storage": {
            "type": "boolean"
          }
        }
      },
      "Track": {
        "type": "object",
        "required": [
          "id",
          "title",
          "speaker",
          "description",
          "durationSeconds",
          "categories",
          "playable"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "durationSeconds": {
            "type": "number",
            "minimum": 0
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "playable": {
            "type": "boolean"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
