{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_ECHO_API_BASE_URL": "https://echo.starry.phd"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_ECHO_API_BASE_URL": "https://echo-api-staging.starry-phd.workers.dev",
        "EXPO_PUBLIC_STARRY_ID_API_BASE_URL": "https://id.starry.phd"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
