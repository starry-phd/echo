{
  "name": "echo-starry",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "check": "npm run api:generate && npm run typecheck && npm run lint && npm test && npm run api:check && npm run monetization:check",
    "test": "node --import tsx --test tests/*.test.mjs",
    "api:check": "node scripts/check-openapi.mjs",
    "lint": "eslint app src worker packages",
    "expo:doctor": "npx --yes expo-doctor@latest",
    "monetization:check": "node scripts/check-v13-manifest.mjs",
    "api:generate": "openapi-typescript openapi/echo-public.v1.json -o packages/echo-api-sdk/src/generated.ts",
    "postinstall": "npm run api:generate"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-router": "~58.0.26",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.10",
    "expo-linking": "~58.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "^0.21.0",
    "react-native-safe-area-context": "^5.0.0",
    "expo-asset": "~58.0.18",
    "@tanstack/react-query": "^5.90.0",
    "hono": "^4.11.0",
    "zod": "^4.1.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.6",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "openapi-typescript": "^7.13.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
