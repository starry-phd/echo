{
  "name": "echo-starry",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run api:check",
    "test": "node --import tsx --test tests/*.test.mjs",
    "api:check": "node scripts/check-openapi.mjs"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-router": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.0",
    "expo-linking": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.0",
    "react-native-safe-area-context": "^5.0.0",
    "expo-asset": "57.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3",
    "tsx": "^4.20.6"
  },
  "overrides": {
    "expo-asset": "57.0.8"
  }
}
